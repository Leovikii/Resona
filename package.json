{
  "name": "resona",
  "private": true,
  "version": "0.0.18",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420",
    "build": "tsc && vite build",
    "licenses": "node scripts/generate-license-report.mjs",
    "preview": "vite preview --port 1421",
    "prepare:sidecars": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-ffmpeg-sidecars.ps1",
    "release:windows": "npm run prepare:sidecars && tauri build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-release-webview.ps1",
    "verify:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-release-webview.ps1",
    "tauri": "npm run prepare:sidecars && tauri"
  },
  "dependencies": {
    "@mantine/core": "^9.4.1",
    "@mantine/hooks": "^9.4.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "i18next": "^26.3.6",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.10"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
