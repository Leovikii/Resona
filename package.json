{
  "name": "resona",
  "private": true,
  "version": "0.1.0-rc.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420",
    "build": "tsc && vite build",
    "licenses": "node scripts/generate-license-report.mjs",
    "icons:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-windows-shell-icons.ps1",
    "preview": "vite preview --port 1421",
    "test:release": "node --test scripts/release-channel.test.mjs",
    "prepare:test-tools": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-ffmpeg-test-tools.ps1",
    "release:windows": "node scripts/prepare-updater-config.mjs && tauri build --bundles nsis --config src-tauri/target/updater.config.json && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/finalize-windows-artifacts.ps1 -RequireUpdaterSignature && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows-distribution.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-release-webview.ps1",
    "verify:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-release-webview.ps1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@mantine/core": "^9.4.1",
    "@mantine/hooks": "^9.4.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "i18next": "^26.3.6",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.10"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
