# CI stages the already compiled application in stage/usr.
pkgname=resona
pkgver=0.3.0beta1
pkgrel=1
pkgdesc='Local audio player with desktop lyrics (Arch Wayland, precompiled)'
arch=('x86_64')
url='https://github.com/Leovikii/Resona'
license=('GPL-3.0-only')
depends=('desktop-file-utils' 'hicolor-icon-theme' 'glibc' 'gcc-libs' 'alsa-lib' 'gtk3' 'webkit2gtk-4.1' 'libsoup3' 'gtk-layer-shell' 'libayatana-appindicator' 'dbus' 'openssl' 'polkit' 'xdg-desktop-portal' 'xdg-desktop-portal-kde' 'kio-fuse' 'kio>=6.23' 'kio-extras' 'qt6-base')
optdepends=('ffmpeg: WAV to FLAC conversion' 'pipewire-alsa: ALSA output via PipeWire')
options=('!strip' '!debug')
package() {
  cp -a "$startdir/stage/usr" "$pkgdir/"
}
