{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Resona",
  "version": "0.3.0-alpha.1",
  "identifier": "io.github.vki.resona",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Resona",
        "width": 1080,
        "height": 700,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "visible": false,
        "backgroundColor": "#101113",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [],
    "category": "Music",
    "publisher": "Viki",
    "copyright": "Copyright © 2026 Viki",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "shortDescription": "A private, local-first desktop audio player",
    "longDescription": "Resona is a local-first desktop audio player with playlists, lyrics, audio output control, and optional lossless compression tools.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/default-artwork.png": "icons/default-artwork.png"
    },
    "fileAssociations": [
      {
        "ext": [
          "mp3"
        ],
        "name": "Resona.MP3",
        "description": "MP3 audio",
        "role": "Viewer",
        "mimeType": "audio/mpeg"
      },
      {
        "ext": [
          "wav"
        ],
        "name": "Resona.WAV",
        "description": "WAV audio",
        "role": "Viewer",
        "mimeType": "audio/wav"
      },
      {
        "ext": [
          "flac"
        ],
        "name": "Resona.FLAC",
        "description": "FLAC audio",
        "role": "Viewer",
        "mimeType": "audio/flac"
      }
    ]
  }
}
