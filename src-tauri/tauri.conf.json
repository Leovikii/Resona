{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Resona",
  "version": "0.0.2",
  "identifier": "io.github.vki.resona",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Resona 0.0.2",
        "width": 680,
        "height": 440,
        "minWidth": 420,
        "minHeight": 320,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
