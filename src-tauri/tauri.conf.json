{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Resona",
  "version": "0.0.18",
  "identifier": "io.github.vki.resona",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Resona 0.0.18",
        "width": 1080,
        "height": 700,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "visible": false,
        "backgroundColor": "#101113",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ]
  }
}
